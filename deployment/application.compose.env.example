# Host-side template. Fill only after selecting the target host and domain.
DEPLOYMENT_STAGE=staging
DASHBOARD_PUBLIC_ORIGIN=https://app.example.com
PUBLIC_WEBHOOK_BASE=https://hooks.example.com/
POSTGRES_DATA_VOLUME=leadgen_target_postgres
N8N_DATA_VOLUME=leadgen_target_n8n
DASHBOARD_DB_USER=lead_dashboard

POSTGRES_PASSWORD_FILE=/srv/leadgen/secrets/postgres-password
DASHBOARD_DATABASE_PASSWORD_FILE=/srv/leadgen/secrets/gateway-database-password
CREDENTIAL_ADAPTER_TOKEN_FILE=/srv/leadgen/secrets/credential-adapter-token
FIREBASE_CREDENTIAL_FILE=/srv/leadgen/secrets/firebase-admin.json
GATHERING_API_KEY_FILE=/srv/leadgen/secrets/gathering-api-key
N8N_API_KEY_FILE=/srv/leadgen/secrets/n8n-api-key
GMAIL_CONFIG_FILE=/srv/leadgen/secrets/gmail-config.json
GMAIL_CLIENT_FILE=/srv/leadgen/secrets/gmail-client.json
GMAIL_STATE_KEY_FILE=/srv/leadgen/secrets/gmail-state.key
N8N_PROVIDER_ENV_FILE=/srv/leadgen/secrets/providers.env

# Remain disabled during staging. Existing content/scope gates still apply later.
ENABLE_APPROVED_AUTOMATION=false
# Exact n8n workflow IDs reviewed for staging. Keep empty until verified.
STAGING_APPROVED_WORKFLOW_IDS=
EMAIL_CAMPAIGN_RENEWAL_ENABLED=false
EMAIL_BATCH_DASHBOARD_START_ENABLED=false
SMS_WORKER_ENABLED=false

# Public website: keep off until the final domain, policies and accounts are ready.
PUBLIC_SITE_INDEXING_ENABLED=false
PUBLIC_ANALYTICS_ENABLED=false
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# HTTPS proxy: choose a reviewed pinned Caddy image digest before public deployment.
APP_DOMAIN=
CADDY_IMAGE=
