# Template only. Supply an exact domain after the host/domain decision.
DASHBOARD_PUBLIC_ORIGIN=https://app.example.com
# Use 0.0.0.0 only inside a private container network behind the HTTPS proxy.
DASHBOARD_BIND_HOST=0.0.0.0
DASHBOARD_FIREBASE_CREDENTIAL=/run/secrets/firebase-admin.json

# Complete connection settings bypass local Docker inspection.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=lead_db
DATABASE_USER=lead_dashboard
DATABASE_PASSWORD_FILE=/run/secrets/database-password
# off: private same-host container network. For a remote DB use verify-full + CA.
DATABASE_TLS=off
# DATABASE_CA_FILE=/run/secrets/database-ca.pem

# Fixed private service destinations, no public workflow editor.
N8N_INTERNAL_ORIGIN=http://n8n:5678
CREDENTIAL_ADAPTER_URL=http://credential-adapter:3013
CREDENTIAL_ADAPTER_TOKEN_FILE=/run/secrets/credential-adapter-token

# First staging boot must not enable automatic campaign renewal or batch sending.
EMAIL_CAMPAIGN_RENEWAL_ENABLED=false
EMAIL_BATCH_DASHBOARD_START_ENABLED=false

# Other current runtime configuration still uses reviewed .local file mounts.
# See README.md; this template alone does not make the service deployable.
