{
  "name": "3C - Facebook Contact Discovery (Budgeted)",
  "nodes": [
    {
      "name": "Every Minute",
      "id": "social-timer",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "name": "Manual Test",
      "id": "social-manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "name": "Advance Facebook Queue",
      "id": "social-worker",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        250,
        0
      ],
      "parameters": {
        "executeOnce": true,
        "command": "node /home/node/.n8n/contact-stage/social-worker.cjs"
      },
      "notesInFlow": true,
      "notes": "Reuses known public-page results; paid starts require global and organization opt-in, verified account binding, budget reservation and platform wallet funding. Resumes saved Apify runs. No Abstract calls or outreach."
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Advance Facebook Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Test": {
      "main": [
        [
          {
            "node": "Advance Facebook Queue",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveManualExecutions": false
  }
}
