    {
      "id": "718d7cdb9449dff9e39e094381cfdb13",
      "name": "Claim Enrichment Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value AS task FROM enrichment_claim('basic',2) value",
        "options": {
          "queryReplacement": "={{ [] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Scc3yxojKZkvXpOL",
          "name": "Lead Database"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "67b5a8bf38a1495c505555d41f94249c",
      "name": "Validate Lease",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// An empty claim is an idle queue, never a task.\nconst queueItems=$input.all();\nif(!queueItems.length||queueItems.every(item=>item&&item.json&&Object.keys(item.json).length===0))return [];\nreturn $input.all().map((item,index)=>{const t=item.json.task;if(!/^\\d+$/.test(String(t.id))||!/^[a-f0-9]{32}$/.test(t.lease))throw Error('Invalid task lease');return {json:t,pairedItem:{item:index}};});"
      }
    },
    {
      "id": "3655c4194d99160452b001b34fe60b3a",
      "name": "Run Enrichment Worker",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "executeOnce": false,
        "command": "={{ 'node /home/node/.n8n/enrichment-stage/worker.cjs ' + $json.id + ' ' + $json.lease }}"
      },
      "notesInFlow": true,
      "notes": "Observed website facts and existing cleaned data. Up to three pages; no AI guesses. Database leases and fingerprints protect ownership and stale results."
    },
    {
      "id": "aedb6994d32f8bdc116aab11049ee0de",
      "name": "Validate Worker Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r=JSON.parse($json.stdout),t=$('Validate Lease').item.json;if(String(r.id)!==String(t.id)||r.lease!==t.lease)throw Error('Result identity mismatch');return r;"
      }
    },
    {
      "id": "dea02ad891598ffe30b58da41b575b36",
      "name": "Save Enrichment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT enrichment_finish($1::jsonb) AS result",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Scc3yxojKZkvXpOL",
          "name": "Lead Database"
        }
      }
    }
