    {
      "name": "Validate Lead Evidence",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "6b0902c33b6115c965ef7065fdf115fa",
      "position": [
        2880,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q=$input.first().json.query||{};const valid=v=>/^[1-9]\\d*$/.test(String(v))&&Number.isSafeInteger(Number(v));return {org_id:valid(q.org_id)?Number(q.org_id):null,lead_id:valid(q.lead_id)?Number(q.lead_id):null};"
      }
    },
    {
      "name": "Read Lead Evidence",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "c52277de41e180f8b6f0c216b9f0df12",
      "position": [
        3120,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE WHEN $1::integer IS NULL OR $2::integer IS NULL THEN jsonb_build_object('error','INVALID_REQUEST') ELSE coalesce(contact_lead_report($1,$2),jsonb_build_object('error','NOT_FOUND')) END AS result",
        "options": {
          "queryReplacement": "={{ [$json.org_id,$json.lead_id] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Scc3yxojKZkvXpOL",
          "name": "Lead Database"
        }
      }
    },
