      ],
      "parameters": {}
    },
    {
      "name": "Claim Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "b844eaf2e21a4a502277f464cbd5fded",
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value AS task FROM contact_claim('discovery',3) value",
        "options": {
          "queryReplacement": "={{ [] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Scc3yxojKZkvXpOL",
          "name": "Lead Database"
        }
      },
      "alwaysOutputData": true
    },
    {
      "name": "Validate Worker Arguments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "1fc369b9bd88dff3226d45c5e74a79f9",
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// An empty claim is an idle queue, never a task.\nconst queueItems=$input.all();\nif(!queueItems.length||queueItems.every(item=>item&&item.json&&Object.keys(item.json).length===0))return [];\nreturn $input.all().map((item,index)=>{const t=item.json.task;if(!/^\\d+$/.test(String(t.id))||!/^[a-f0-9]{32}$/.test(t.lease))throw Error('Invalid task lease');return {json:t,pairedItem:{item:index}};});"
      }
    },
    {
      "name": "Run Contact Worker",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "id": "f71ad292d4594036e450d4a71fe13f42",
      "position": [
        960,
        0
      ],
      "parameters": {
        "executeOnce": false,
        "command": "={{ 'node /home/node/.n8n/contact-stage/worker.cjs ' + $json.id + ' ' + $json.lease }}"
      },
      "notes": "Qualify business contacts, recover saved records, reuse scoped caches, then crawl if needed. Weak/unrelated emails do not stop discovery. Queue a known Facebook page for workflow 03c when unresolved. Paid lookups are opt-in; evidence and source snapshots protect identity. No outreach.",
      "notesInFlow": true
    },
    {
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "7469cb73b1246e0e01472a7a1c4cb86b",
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r=JSON.parse($json.stdout);const t=$('Validate Worker Arguments').item.json;if(String(r.id)!==String(t.id)||r.lease!==t.lease)throw Error('Result identity mismatch');return r;"
      }
    },
    {
      "name": "Save Outcome",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "a020773b0299532667eadf2c051845bd",
      "position": [
        1440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT contact_finish($1::jsonb) AS result",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Scc3yxojKZkvXpOL",
          "name": "Lead Database"
        }
      }
    },
    {
