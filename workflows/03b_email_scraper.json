        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "leadGatheringAuth",
          "name": "Lead Gathering API"
        }
      },
      "webhookId": "b4fac262-8194-4d90-81e6-1901ff1057ff"
    },
    {
      "name": "Validate Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "1731cb844275a39661fd8cc992f0fefd",
      "position": [
        1920,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q=$input.first().json.query||{};return {org_id:/^[1-9]\\d*$/.test(String(q.org_id))&&Number.isSafeInteger(Number(q.org_id))?Number(q.org_id):null};"
      }
    },
    {
      "name": "Read Contact Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "044d58fd45c7475a49d6986f34973c1a",
      "position": [
        2160,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT CASE WHEN $1::integer IS NULL THEN jsonb_build_object('error','INVALID_REQUEST') WHEN NOT EXISTS(SELECT 1 FROM organizations WHERE id=$1) THEN jsonb_build_object('error','NOT_FOUND') ELSE contact_report($1) END AS result",
        "options": {
          "queryReplacement": "={{ [$json.org_id] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Scc3yxojKZkvXpOL",
          "name": "Lead Database"
        }
      }
    },
    {
      "name": "Status Response",
      "type": "n8n-nodes-base.respondToWebhook",
