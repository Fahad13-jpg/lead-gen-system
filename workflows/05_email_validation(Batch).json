      ],
      "parameters": {}
    },
    {
      "name": "Claim Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "5d2542db3c8eb4299976de3f9a1e5ab3",
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT value AS task FROM contact_claim('verification',1) value",
        "options": {
          "queryReplacement": "={{ [] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Scc3yxojKZkvXpOL",
          "name": "Lead Database"
        }
      },
      "alwaysOutputData": true
    },
    {
      "name": "Validate Worker Arguments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "69e89e21a920b11953d76438ce1abc8a",
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// An empty claim is an idle queue, never a task.\nconst queueItems=$input.all();\nif(!queueItems.length||queueItems.every(item=>item&&item.json&&Object.keys(item.json).length===0))return [];\nreturn $input.all().map((item,index)=>{const t=item.json.task;if(!/^\\d+$/.test(String(t.id))||!/^[a-f0-9]{32}$/.test(t.lease))throw Error('Invalid task lease');return {json:t,pairedItem:{item:index}};});"
      }
    },
    {
      "name": "Run Contact Worker",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "id": "b34526fe6c108e10198278d3dd99b76c",
      "position": [
        960,
        0
      ],
      "parameters": {
        "executeOnce": false,
        "command": "={{ 'node /home/node/.n8n/contact-stage/worker.cjs ' + $json.id + ' ' + $json.lease }}"
      }
    },
    {
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "id": "c4eda81c64decaafa0d39357b1179432",
      "position": [
        1200,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const r=JSON.parse($json.stdout);const t=$('Validate Worker Arguments').item.json;if(String(r.id)!==String(t.id)||r.lease!==t.lease)throw Error('Result identity mismatch');return r;"
      }
    },
    {
      "name": "Save Outcome",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "id": "b72793d29e8fc8bf5dc886303094f5cc",
      "position": [
        1440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT contact_finish($1::jsonb) AS result",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json)] }}",
          "queryBatching": "independently"
        }
      },
      "credentials": {
        "postgres": {
          "id": "Scc3yxojKZkvXpOL",
          "name": "Lead Database"
        }
      }
    }
  ],
