      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return (function validateConnection() {\n  const b = $input.first().json.body || {};\n  if (!/^\\d+$/.test(String(b.org_id)) || !Number.isSafeInteger(Number(b.org_id)) || Number(b.org_id) < 1 || typeof b.apify_api_key !== 'string' || !/^apify_api_[A-Za-z0-9]+$/.test(b.apify_api_key.trim())) return { error: true, http_status: 400, message: 'A positive org_id and valid-format Apify key are required' };\n  return { error: false, org_id: Number(b.org_id), apify_api_key: b.apify_api_key.trim() };\n})();"
      }
